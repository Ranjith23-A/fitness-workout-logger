# Fitness & Workout Logger - Server Environment Variables
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fitness_tracker?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_fitness_workout_logger_2026_secure
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Optional Email Verification Configuration (if using real SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@fitlog.app
